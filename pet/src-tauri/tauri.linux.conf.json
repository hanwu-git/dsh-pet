{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSH Pet",
        "width": 420,
        "height": 440,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-background-networking --disable-sync --disable-extensions --disable-features=Translate,BackForwardCache,MediaRouter,OptimizationHints --js-flags=--max-old-space-size=96"
      }
    ]
  }
}
